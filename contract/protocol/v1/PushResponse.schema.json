{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PushResponse",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "acked",
    "refused"
  ],
  "properties": {
    "acked": {
      "description": "Applied now or earlier: drop them from the outbox.",
      "type": "array",
      "items": {
        "pattern": "^[A-Za-z0-9_-]{1,64}:[1-9][0-9]{0,15}$",
        "type": "string"
      }
    },
    "refused": {
      "description": "Never applied: roll them back locally and tell the app (ADR-0006).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op_id",
          "reason"
        ],
        "properties": {
          "op_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
